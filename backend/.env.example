# DeepSeek API 配置模板
# 使用方法：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# 必填：DeepSeek API Key，申请地址 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：接口地址（默认 https://api.deepseek.com）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：默认模型（deepseek-flash 快速便宜；deepseek-v4-pro 重推理任务）
DEEPSEEK_MODEL=deepseek-flash

# 可选：服务端口（默认 3000）
PORT=3000
