# 模型服务环境配置模板
# 使用方法：复制本文件为 .env（.env 已被 .gitignore 忽略，不会提交）

# 可选：模型设置页用户 Key 的环境变量后备项。推荐在设置页填写用户 Key。
DEEPSEEK_API_KEY=
GLM_API_KEY=

# 可选：接口地址（默认 https://api.deepseek.com）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 用户 Key 首次保存时自动生成并写入此变量；不要删除或提交真实值。
LLM_CREDENTIAL_ENCRYPTION_KEY=

# 可选：服务端口（默认 3000）
PORT=3000

# ---------- 当前模型的通用默认参数 ----------
LLM_DEEPSEEK_MODEL=deepseek-flash
LLM_GLM_MODEL=glm-5.3
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60000

# ---------- 重试与预算 ----------
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_INTERVAL=500
LLM_RETRY_BACKOFF_FACTOR=2
LLM_RETRY_MAX_INTERVAL=10000
LLM_RETRY_JITTER=true

# 结构化输出的校验修复重试次数（不含首次调用）
LLM_STRUCTURED_MAX_REPAIR_ATTEMPTS=2

# 单次生成请求的累计模型调用上限（防止重试叠加导致成本失控）
LLM_BUDGET_MAX_CALLS_PER_REQUEST=6

# ---------- 成本估算 ----------
# 每百万 token 单价（人民币）。留空则只记录 token 数，不估算费用
LLM_PRICE_INPUT_PER_MTOKENS=
LLM_PRICE_OUTPUT_PER_MTOKENS=

# ---------- 数据库 ----------
# SQLite 数据库文件位置（相对 backend 目录）
DATABASE_URL="file:./dev.db"

# 流水线执行快照（checkpoint）的 SQLite 库，独立于业务库 dev.db，避免共享文件锁竞争
CHECKPOINT_DB="file:./checkpoints.db"

# 大纲单批调用超时、本次章纲执行预算、单次最大输出 token
OUTLINE_CALL_TIMEOUT_MS=120000
OUTLINE_TOTAL_TIMEOUT_MS=480000
OUTLINE_MAX_TOKENS=8192

# 正文输出目录（默认仓库根目录/output；自定义时建议绝对路径）
# PROSE_OUTPUT_DIR=/absolute/path/to/output
# 上下文字符预算，超限明确报错，不静默漏读正文和前文摘要
# PROSE_CONTEXT_CHARS=180000
# 每章正文提示词目标字数（指导目标，不承诺精确字数）
# PROSE_TARGET_WORDS_SHORT=2000
