# DeepSeek API 配置模板
# 使用方法：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# 必填：DeepSeek API Key，申请地址 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：接口地址（默认 https://api.deepseek.com）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：服务端口（默认 3000）
PORT=3000

# ---------- 模型用途配置 ----------
# draft：草稿生成，快速便宜，默认关闭思维链
LLM_DRAFT_MODEL=deepseek-flash
LLM_DRAFT_TEMPERATURE=0.9
LLM_DRAFT_MAX_TOKENS=2048
LLM_DRAFT_TIMEOUT=60000
LLM_DRAFT_THINKING=false

# reasoning：重推理任务，默认开启思维链（成本显著更高）
LLM_REASONING_MODEL=deepseek-flash
LLM_REASONING_TEMPERATURE=0.3
LLM_REASONING_MAX_TOKENS=4096
LLM_REASONING_TIMEOUT=120000
LLM_REASONING_THINKING=true

# ---------- 重试与预算 ----------
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_INTERVAL=500
LLM_RETRY_BACKOFF_FACTOR=2
LLM_RETRY_MAX_INTERVAL=10000
LLM_RETRY_JITTER=true

# 结构化输出的校验修复重试次数（不含首次调用）
LLM_STRUCTURED_MAX_REPAIR_ATTEMPTS=2

# 单次生成请求的累计模型调用上限（防止重试叠加导致成本失控）
LLM_BUDGET_MAX_CALLS_PER_REQUEST=6

# ---------- 成本估算 ----------
# 每百万 token 单价（人民币）。留空则只记录 token 数，不估算费用
LLM_PRICE_INPUT_PER_MTOKENS=
LLM_PRICE_OUTPUT_PER_MTOKENS=

# ---------- 数据库 ----------
# SQLite 数据库文件位置（相对 backend 目录）
DATABASE_URL="file:./dev.db"

# 流水线执行快照（checkpoint）的 SQLite 库，独立于业务库 dev.db，避免共享文件锁竞争
CHECKPOINT_DB="file:./checkpoints.db"
