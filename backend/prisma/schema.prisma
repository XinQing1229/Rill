// Prisma schema（SQLite）
// 注意：SQLite 不支持 enum 与 Json 类型，枚举以 String 存储，结构化内容以 JSON 字符串存储

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id                   String   @id @default(cuid())
  title                String
  genre                String
  length               String
  mode                 String   @default("manual") // manual | auto
  currentStage         String
  status               String   @default("idle") // idle | running | done | failed
  // 问卷答案（JSON 字符串）：必答 4 项 + 选答 + 类型级联项
  answers              String   @default("{}")
  questionnaireVersion String   @default("v1")
  promptTokens         Int      @default(0)
  completionTokens     Int      @default(0)
  runId                String?
  // 软删除时刻：非空即已移入回收站，恢复时置空（产物数据在回收站期间保持冻结）
  deletedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  outline Outline?
  premise Premise?
  world WorldSetting?
  characters Character[]
  relations Relation[]
  stageRuns StageRun[]

  @@index([deletedAt])
}

model StageRun {
  stale            Boolean  @default(false)
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runId            String
  stage            String
  status           String   @default("pending")
  error            String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  confirmedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([projectId, runId, stage])
  @@index([projectId, stage, updatedAt])
}

model Premise {
  id               String   @id @default(cuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 种子产物（JSON 字符串），按 PremiseSchema 校验后写入；不含问卷已选维度
  data             String
  status           String   @default("pending") // pending | generating | done | failed
  stale            Boolean  @default(false)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WorldSetting {
  id               String   @id @default(cuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 通用骨架 + 类型自定义块（JSON 字符串）；era/place 由种子继承后填入
  data             String
  status           String   @default("pending")
  stale            Boolean  @default(false)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Character {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  role             String // protagonist | supporting | antagonist
  // 完整人物卡（JSON 字符串）
  data             String
  status           String   @default("pending")
  stale            Boolean  @default(false)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  relationsFrom Relation[] @relation("RelationFrom")
  relationsTo   Relation[] @relation("RelationTo")

  @@index([projectId])
}

model Relation {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 规范化：fromId 恒小于 toId，同一对人物只存一条；方向性由 fromRole/toRole 表达
  fromId      String
  toId        String
  from        Character @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to          Character @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)
  type        String
  fromRole    String
  toRole      String
  description String
  status      String    @default("pending")
  stale       Boolean   @default(false)
  promptTokens Int      @default(0)
  completionTokens Int  @default(0)
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, fromId, toId])
  @@index([projectId])
}


model Outline {
  id String @id @default(cuid())
  projectId String @unique
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetChapters Int
  step String @default("planning")
  revision Int @default(0)
  planRevision Int @default(0)
  planConfirmedRevision Int?
  confirmedRevision Int?
  planData String?
  stale Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  batches OutlineBatch[]
}

model OutlineBatch {
  id String @id @default(cuid())
  outlineId String
  outline Outline @relation(fields: [outlineId], references: [id], onDelete: Cascade)
  planRevision Int
  startChapter Int
  endChapter Int
  segmentId String
  data String?
  status String @default("pending")
  error String?
  promptTokens Int @default(0)
  completionTokens Int @default(0)
  @@unique([outlineId, planRevision, startChapter])
}

model OutlineUsage {
  traceId String @id
  projectId String
  promptTokens Int
  completionTokens Int
}
